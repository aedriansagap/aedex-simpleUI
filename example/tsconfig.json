{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@aedriansagap/styling-simplified": ["../src/index.ts"],
      "@aedriansagap/styling-simplified/plugin": ["../src/plugin.ts"]
    }
  },
  "include": ["src"]
}
